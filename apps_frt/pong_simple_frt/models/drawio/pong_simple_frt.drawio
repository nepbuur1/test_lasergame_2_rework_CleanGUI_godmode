        <mxCell id="dc-running" parent="1" style="shape=mxgraph.sysml.simpleState;html=1;overflow=fill;whiteSpace=wrap;align=center;" value="&lt;p style=&quot;margin: 0px ; margin-top: 4px ; text-align: center&quot;&gt;Running&lt;/p&gt;&lt;hr&gt;&lt;p&gt;&lt;/p&gt;&lt;p style=&quot;margin: 0px ; margin-left: 8px ; text-align: left&quot;&gt;eventBitShowStartPage / showPage(startPagePanel)&lt;/p&gt;&lt;p style=&quot;margin: 0px ; margin-left: 8px ; text-align: left&quot;&gt;eventBitHideStartPage / hidePage(startPagePanel)&lt;/p&gt;&lt;p style=&quot;margin: 0px ; margin-left: 8px ; text-align: left&quot;&gt;eventBitShowGamePage / initBallAndPaddlePosition(); showPage(gamePanel)&lt;/p&gt;&lt;p style=&quot;margin: 0px ; margin-left: 8px ; text-align: left&quot;&gt;eventBitHideGamePage / hidePage(gamePanel); xEventGroupClearBits(eventGroup, eventBitShowPaddle); &lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;xEventGroupClearBits(eventGroup, eventBitHidePaddle)&lt;/p&gt;&lt;p style=&quot;margin: 0px ; margin-left: 8px ; text-align: left&quot;&gt;eventBitShowGameOverPage / showPage(gameOverPanel)&lt;/p&gt;&lt;p style=&quot;margin: 0px ; margin-left: 8px ; text-align: left&quot;&gt;eventBitHideGameOverPage / hidePage(gameOverPanel)&lt;/p&gt;&lt;p style=&quot;margin: 0px ; margin-left: 8px ; text-align: left&quot;&gt;eventBitShowPaddle [gamePanel.isDrawable()] / showPaddleAndButtons()&lt;/p&gt;&lt;p style=&quot;margin: 0px ; margin-left: 8px ; text-align: left&quot;&gt;eventBitHidePaddle / hidePaddleAndButtons()&lt;/p&gt;&lt;p style=&quot;margin: 0px ; margin-left: 8px ; text-align: left&quot;&gt;eventBitPaddlePositionUpdated / int paddlePosition; xQueuePeek(paddlePositionQueue, &amp;amp;paddlePosition, 0); &lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;movePaddlePanel(paddlePosition)&lt;/p&gt;&lt;p style=&quot;margin: 0px ; margin-left: 8px ; text-align: left&quot;&gt;eventBitBallPositionUpdated / TwoNumbers ballPosition; xQueuePeek(ballPositionQueue, &amp;amp;ballPosition, 0); &lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; moveBallPanel(ballPosition); countFrameAndReportFps()&lt;/p&gt;" vertex="1">
          <mxGeometry height="240" width="620" x="80" y="470" as="geometry" />
        </mxCell>
        <mxCell id="dc-e0" edge="1" parent="1" source="dc-init" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;curved=0;align=left;labelBackgroundColor=default;" target="dc-running" value="/ PageRoot&amp;lt;20&amp;gt; pageRoot(&quot;rootSceneDisplay&quot;, display);&lt;br&gt;initGamePanels(); initGameOverPanels(); initStartPagePanels();&lt;br&gt;defineDisplayHierarchy(pageRoot);&lt;br&gt;hidePage(gamePanel); hidePage(gameOverPanel); hidePage(startPagePanel)">
          <mxGeometry relative="1" y="10" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dc-note" parent="1" style="shape=note;size=15;align=left;spacingLeft=10;html=1;whiteSpace=wrap;verticalAlign=top;fontFamily=Courier New;fontSize=11;spacingTop=6;" value="// Hulpfuncties met interactie met de buitenwereld (queues, eventbits, log): de code.&lt;br&gt;void &lt;b&gt;initBallAndPaddlePosition()&lt;/b&gt;&lt;br&gt;{&lt;br&gt;&amp;nbsp; &amp;nbsp; TwoNumbers ballPosition;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;xQueuePeek(ballPositionQueue, &amp;amp;ballPosition, 0);&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ballPanel.setLocPos(centreToTopLeftPix(ballPosition.number1, ballPosition.number2, ballSizePix()),&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;CoordType::Pixels, Alignment::MidMid);&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;int paddlePosition;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;xQueuePeek(paddlePositionQueue, &amp;amp;paddlePosition, 0);&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;paddlePanel.setLocPos(centreToTopLeftPix(paddlePosition, PaddleHeightPix/2, paddleSizePix()),&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;CoordType::Pixels, Alignment::MidMid);&lt;br&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;xEventGroupClearBits(eventGroup, eventBitBallPositionUpdated);        // zojuist verwerkt; redraw(true) tekent ze.&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;xEventGroupClearBits(eventGroup, eventBitPaddlePositionUpdated);&lt;br&gt;}&lt;br&gt;&lt;br&gt;// Beeldtelling, om te kunnen nagaan of de 25 per seconde ook echt&lt;br&gt;// gehaald worden in plaats van dat aan te nemen. Eens per seconde in het log.&lt;br&gt;int32_t nofFrames = 0;&lt;br&gt;int64_t timeOfLastReportUs = esp_timer_get_time();&lt;br&gt;&lt;br&gt;void &lt;b&gt;countFrameAndReportFps()&lt;/b&gt;&lt;br&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;nofFrames++;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;int64_t nowUs = esp_timer_get_time();&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if (nowUs - timeOfLastReportUs &amp;gt;= 1000000)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ESP_LOGI(&quot;pong&quot;, &quot;%d fps&quot;, (int)nofFrames);&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;nofFrames = 0;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;timeOfLastReportUs = nowUs;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;}&lt;br&gt;}&lt;br&gt;&lt;br&gt;// Hulpfuncties zonder interactie met de buitenwereld (alleen de eigen widgets):&lt;br&gt;void initGamePanels(), initGameOverPanels(), initStartPagePanels():&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;maat, plek en kleur van de widgets van die pagina.&lt;br&gt;void defineDisplayHierarchy(IWidget&amp;amp; pageRoot):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;pageRoot { gamePanel { bottomLinePanel, leftBorderPanel, rightBorderPanel, topBorderPanel,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ballPanel, paddlePanel, buttonLeft, buttonRight },&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;gameOverPanel { gameOverLabelPanel { gameOverText }, buttonGameOverStart },&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;startPagePanel { startPageTitle, buttonStartPageStart } }&lt;br&gt;void showPage(IWidget&amp;amp; page):   tekenbaar maken, tekenen, aanraakbaar maken.&lt;br&gt;void hidePage(IWidget&amp;amp; page):   niet aanraakbaar en niet tekenbaar maken, zonder te tekenen.&lt;br&gt;void showPaddleAndButtons():    paddlePanel, buttonLeft, buttonRight: show + enable.&lt;br&gt;void hidePaddleAndButtons():    paddlePanel, buttonLeft, buttonRight: eerst disable, dan hide.&lt;br&gt;void movePaddlePanel(int paddlePosition):           paddlePanel.moveTo() naar die positie.&lt;br&gt;void moveBallPanel(const TwoNumbers&amp;amp; ballPosition): ballPanel.moveTo() naar die positie." vertex="1">
          <mxGeometry height="680" width="740" x="60" y="800" as="geometry" />
        </mxCell>
        <mxCell id="std-separator" parent="1" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;" value="" vertex="1">
          <mxGeometry height="8" width="780" x="20" y="335" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
