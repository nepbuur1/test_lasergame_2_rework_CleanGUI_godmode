---
title: "cd StateMachine Pro"
config:
  layout: elk
  theme: base
  themeCSS: "& { background-color: #ffffff; }"
  themeVariables:
    background: "#ffffff"
    mainBkg: "#ffffff"
    primaryColor: "#ffffff"
    primaryTextColor: "#000000"
    primaryBorderColor: "#333333"
    nodeBorder: "#333333"
    textColor: "#000000"
    nodeTextColor: "#000000"
    titleColor: "#000000"
    classText: "#000000"
    lineColor: "#333333"
    edgeLabelBackground: "#ffffff"
    noteBkgColor: "#fff9c4"
    noteTextColor: "#000000"
    noteBorderColor: "#9e9e9e"
---
classDiagram
    direction TB
    %% Klassen
    class InputSimulator {
        <<isActive» «control>>
        -machineControl : MachineControl#amp;
    }
    class MachineControl {
        <<isActive» «control>>
        -counter : Counter#amp;
        +button1Pressed()
        +button2Pressed()
        +knobTurned(knobValue:uint8_t)
        +keyTyped(character:uint8_t)
        +telegramCharacterReceived(character:uint8_t)
        +getScoreCount() int
    }
    class Counter {
        <<isActive» «control>>
        +getCounterValue() int
    }

    %% Relaties
    InputSimulator --> MachineControl
    MachineControl --> Counter
