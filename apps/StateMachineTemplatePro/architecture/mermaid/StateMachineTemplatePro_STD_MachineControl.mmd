    interface : xEventGroupSetBits(eventGroup, eventBitKnobTurned)
    interface : keyTyped(character) / xQueueSend(keyTypedQueue, #amp;character, portMAX_DELAY)#59;
    interface : xEventGroupSetBits(eventGroup, eventBitKeyTypedQueue)
    interface : telegramCharacterReceived(character) / xQueueSend(telegramQueue, #amp;character, portMAX_DELAY)
    interface : getScore / int score=0#59; xQueuePeek(scoreQueue, #amp;score, 0)#59; return score
    state choice1 <<choice>>
    state "State K" as State_K
    state "State A" as State_A
    State_A : entry / setLEDColor(Color#58;#58;Green)#59;
    state choice2 <<choice>>
    state choice3 <<choice>>
    state choice4 <<choice>>
    state "State B" as State_B
    State_B : entry / setLEDColor(Color#58;#58;Blue)#59;
    state "State E" as State_E
    State_E : entry / setLEDColor(Color#58;#58;Magenta)
    state "State J" as State_J
    State_J : entry / xEventGroupClearBits(eventGroup,eventBitTimer10sec)#59;
    State_J : xTimerStart(timer10sec, portMAX_DELAY)
    state "State C" as State_C
    State_C : entry / setLEDColor(Color#58;#58;Red)#59;
    state "State D" as State_D
    State_D : entry / setLEDColor(Color#58;#58;Cyan)
    state choice5 <<choice>>
    state "State F" as State_F
    State_F : entry / setLEDColor(Color#58;#58;Yellow)#59;
    State_F : executingCount++#59;
    state "State I" as State_I
    state choice6 <<choice>>
    state choice7 <<choice>>
    state choice8 <<choice>>
    state "State H" as State_H
    state "State G" as State_G
    state choice9 <<choice>>

    %% Transities
    [*] --> State_A : / executingCount = 0#59;<br>timer10sec = xTimerCreate(#quot;Timer10sec#quot;, pdMS_TO_TICKS(ms),<br>pdFALSE, this, timer10secCallback)
    choice1 --> State_K : [uxQueueMessagesWaiting(telegramQueue) #gt; 0]
    choice1 --> State_A : [else]
    State_K --> choice1 : telegramQueue<br>/ xQueueReceive(telegramQueue,<br>#amp;telegramCharacter, portMAX_DELAY)
    State_A --> State_B : eventBitButton1Pressed,<br>eventBitButton2Pressed
    choice2 --> State_K
    choice3 --> choice2
    choice4 --> choice3 : [(nameLen==MAXNAME_SIZE) || (character == '.')]
    choice4 --> State_J : [else]
    State_B --> State_C : eventBitButton1Pressed + eventBitButton2Pressed
    State_E --> choice2 : after(5s)
    State_J --> choice3 : eventBitTimer10sec
    State_J --> choice4 : eventBitKeyTypedQueue<br>[tryReadQueue(keyTypedQueue,character,<br>eventGroup,eventBitKeyTypedQueue)]<br>/ nameBuffer[nameLen++] = character#59;<br>nameBuffer[nameLen]=0
    State_C --> State_E : eventBitButton2Pressed
    State_C --> State_D : eventBitButton1Pressed
    State_D --> State_F : after(1s) / executingCount = 0
    choice5 --> State_J : [(nameLen==MAXNAME_SIZE) || (character == '.')]<br>/ nameLen = 0#59;<br>nameBuffer[nameLen] = 0#59;<br>setLEDColor(Color#58;#58;Cyan)#59;<br>xQueueReset(keyTypedQueue)#59;<br>xEventGroupClearBits(eventGroup, eventBitKeyTypedQueue)#59;
    choice5 --> State_I : [else]
    State_F --> choice8 : eventBitButton1Pressed
    State_I --> choice5 : eventBitKeyTypedQueue [tryReadQueue(keyTypedQueue, character,<br>eventGroup, eventBitKeyTypedQueue)]<br>/ nameBuffer[nameLen++] = character#59;<br>nameBuffer[nameLen]=0
    choice6 --> choice7 : [knobValue #gt; 127]
    choice6 --> State_H : [else]
    choice7 --> State_I : / nameLen = 0#59;<br>nameBuffer[nameLen] = 0#59;<br>setLEDColor(Color#58;#58;Red)#59;<br>xQueueReset(keyTypedQueue)#59;<br>xEventGroupClearBits(eventGroup,<br>eventBitKeyTypedQueue)#59;
    choice8 --> State_F : [executingCount #lt; 3]
    choice8 --> State_G : [else]<br>/ int score#59; xQueuePeek(scoreQueue,#amp;score,0)#59;<br>score ++#59; xQueueOverwrite(scoreQueue, #amp;score)#59;<br>setLEDColor(Color#58;#58;Magenta)
    State_H --> choice6 : eventBitKnobTurned<br>/ xQueuePeek(knobValueQueue, #amp;knobValue, 0)
    State_H --> choice7 : after (5s)
    State_G --> choice9 : eventBitButton1Pressed
    choice9 --> State_H : [else]<br>/setLEDColor(Color#58;#58;Yellow)
    choice9 --> State_G : [counter.getCounterValue()#lt;3]

    %% Notes
    note right of interface
        Als het wachten op een zekere queue overal gebeurt zonder gelijktijdig te
        #nbsp;#nbsp;#nbsp;#nbsp;wachten op iets anders, is er geen gekoppeld eventbit nodig, en kan het
        #nbsp;#nbsp;#nbsp;#nbsp;eenvoudig zo#58;
        xQueueReceive(telegramQueue, #amp;telegramCharacter, portMAX_DELAY).
        Dat commando doet alles in een#58; wachten totdat er iets in de queue zit, en
        #nbsp;#nbsp;#nbsp;#nbsp;vervolgens het resultaat in telegramCharacter schrijven.
        Als er wel een gekoppeld eventbit is, wacht dan altijd zoals bij State I.
    end note
    note left of choice8
        Beslis een richting aan de hand van een boolean conditie.
    end note
