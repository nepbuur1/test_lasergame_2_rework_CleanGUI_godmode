stateDiagram-v2
    direction TB
    %% Toestanden
    state "«interface»" as interface
    interface : button1Pressed / xEventGroupSetBits(eventGroup, eventBitButton1Pressed)
    interface : button2Pressed / xEventGroupSetBits(eventGroup, eventBitButton2Pressed)
