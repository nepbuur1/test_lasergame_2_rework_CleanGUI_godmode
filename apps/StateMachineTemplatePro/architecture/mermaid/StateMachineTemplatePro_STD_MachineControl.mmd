    note2 : eventBitKeyTyped | eventBitTimer10sec,
    note2 : pdTRUE, pdFALSE, portMAX_DELAY)#59;
    note2 : #125; while (((uxBits #amp; eventBitTimer10sec) == 0) #amp;#amp;
