        <mxCell id="KCqLCuhq2eW9A4EWTbgu-20" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;" value="Ook voor het alleen wachten op één enkele&amp;nbsp; queue waar een eventbit aan gekoppeld is, moet op dat eventbit gewacht worden ipv direct op de queue, zodat er geen probleem ontstaat met het syncen van dat eventbit." vertex="1">
