        <mxCell id="PNuX9kIYGe2cK3npaX93-13" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;" value="&lt;div&gt;void MachineControl::timer10secCallback(TimerHandle_t xTimer)&amp;nbsp;&lt;/div&gt;&lt;div&gt;{&lt;/div&gt;&lt;div&gt;&amp;nbsp; MachineControl *instance = static_cast&amp;lt;MachineControl *&amp;gt;(pvTimerGetTimerID(xTimer));&lt;/div&gt;&lt;div&gt;&amp;nbsp; xEventGroupSetBits(instance-&amp;gt;eventGroup, instance-&amp;gt;eventBitTimer10sec);&amp;nbsp;&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;" vertex="1">
