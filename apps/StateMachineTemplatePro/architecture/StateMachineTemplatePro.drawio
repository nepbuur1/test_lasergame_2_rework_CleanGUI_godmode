        <mxCell id="KCqLCuhq2eW9A4EWTbgu-22" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;" value="&lt;div&gt;// Leest niet-blokkerend één bericht uit queue en trekt daarna het&lt;/div&gt;&lt;div&gt;// event-bit gelijk met de werkelijke queue-inhoud. Geeft true als er een&lt;/div&gt;&lt;div&gt;// bericht gelezen is.&lt;/div&gt;&lt;div&gt;template&amp;lt;typename T&amp;gt;&lt;/div&gt;&lt;div&gt;bool tryReadQueue(QueueHandle_t&amp;amp; queue, T&amp;amp; item,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; EventGroupHandle_t&amp;amp; eventGroup,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; const EventBits_t&amp;amp; eventBitQueue)&lt;/div&gt;&lt;div&gt;{&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // Niet-blokkerend lezen (timeout 0 ticks).&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; bool bSucces = (xQueueReceive(queue, &amp;amp;item, 0) == pdPASS);&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; // Event-bit gelijktrekken met de werkelijke queue-inhoud.&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; if (uxQueueMessagesWaiting(queue) &amp;gt; 0)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; xEventGroupSetBits(eventGroup, eventBitQueue);&amp;nbsp; &amp;nbsp; &amp;nbsp; // er staat nog iets: bit aan&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; else&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; xEventGroupClearBits(eventGroup, eventBitQueue);&amp;nbsp; &amp;nbsp; // leeg: bit uit&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (uxQueueMessagesWaiting(queue) &amp;gt; 0)&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // schrijver tussendoor gekomen?&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; xEventGroupSetBits(eventGroup, eventBitQueue);&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; return bSucces;&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;" vertex="1">
          <mxGeometry height="390" width="490" x="1080" y="435" as="geometry" />
        </mxCell>
        <mxCell id="KCqLCuhq2eW9A4EWTbgu-23" edge="1" parent="1" style="endArrow=none;dashed=1;html=1;dashPattern=1 3;strokeWidth=2;rounded=0;" target="KCqLCuhq2eW9A4EWTbgu-22" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
