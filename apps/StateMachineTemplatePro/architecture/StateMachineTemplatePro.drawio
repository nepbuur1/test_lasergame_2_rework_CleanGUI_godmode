        <mxCell id="KCqLCuhq2eW9A4EWTbgu-17" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;" value="Wachten op een tijd of queue en nog iets anders tegelijk, implicieert wachten op eventbits die er aan gelieerd zijn:&lt;br&gt;&lt;br&gt;&lt;div&gt;uxBits = xEventGroupWaitBits(eventGroup,&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; eventBitTimer5sec | eventBitKnobTurned, &lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; pdTRUE, pdFALSE, portMAX_DELAY);&lt;/div&gt;" vertex="1">
