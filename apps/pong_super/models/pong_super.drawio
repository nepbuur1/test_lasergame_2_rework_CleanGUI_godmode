        <mxCell id="TnJXvQ2mKdRsLpWc-11" parent="TnJXvQ2mKdRsLpWc-1" style="shape=note;size=15;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;html=1;whiteSpace=wrap;" value="&lt;div&gt;&lt;div&gt;void &lt;b&gt;applyGameState()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;{&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt; &lt;/span&gt;BallStates ballStates;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt; &lt;/span&gt;poolBallStates.read(ballStates);&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt; &lt;/span&gt;CrateStates crateStates;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt; &lt;/span&gt;poolCrateStates.read(crateStates);&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt; &lt;/span&gt;FireBinStates fireBinStates;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt; &lt;/span&gt;poolFireBinStates.read(fireBinStates);&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt; &lt;/span&gt;int32_t score;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt; &lt;/span&gt;poolScore.read(score);&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt; &lt;/span&gt;applyCrateStates(crateStates);&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt; &lt;/span&gt;applyFireBinStates(fireBinStates);&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt; &lt;/span&gt;applyScore(score);&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt; &lt;/span&gt;applyBallStates(ballStates);&lt;/span&gt;&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="300" width="250" x="70" y="580" as="geometry" />
        </mxCell>
        <mxCell id="TnJXvQ2mKdRsLpWc-12" parent="TnJXvQ2mKdRsLpWc-1" style="shape=note;size=15;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;html=1;whiteSpace=wrap;" value="&lt;b&gt;Waarom per frame de hele boom&lt;/b&gt; - deze app rekent op de backbuffer&lt;br&gt;van de PAL8-adapter; GameDisplayControl::main() controleert dat.&lt;br&gt;&lt;br&gt;Tekenen in geheugen is bijna gratis, maar uitsturen kost altijd&lt;br&gt;het hele scherm (~31 ms). Dan is de hele boom opnieuw opbouwen&lt;br&gt;en er een redraw() overheen doen goedkoper dan het slim proberen&lt;br&gt;te doen - en flikkervrij: er komt pas iets op het scherm als het&lt;br&gt;beeld af is.&amp;nbsp;&lt;br&gt;&lt;br&gt;redraw() en niet show(): de boom zit vol widgets die met opzet&lt;br&gt;uit staan (ongebruikte bal-, crate- en vuurkorfslots, en na&lt;br&gt;hidePaddle ook de peddel). show() zou die weer aanzetten." vertex="1">
          <mxGeometry height="200" width="400" x="70" y="910" as="geometry" />
        </mxCell>
        <mxCell id="TnJXvQ2mKdRsLpWc-13" parent="TnJXvQ2mKdRsLpWc-1" style="shape=note;size=15;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;html=1;whiteSpace=wrap;" value="&lt;b&gt;Toestanden&lt;br&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;Hidden&lt;/b&gt;: de spelpagina is niet in beeld. Er wordt niets getekend;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;binnenkomende beeld- en peddelvlaggen worden niet afgewacht&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;en dus ook niet verwerkt.&lt;br&gt;&lt;b&gt;Shown&lt;/b&gt;: de spelpagina is in beeld en wordt bijgewerkt op elke&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;stand die GameControl en PaddleControl doorgeven." vertex="1">
          <mxGeometry height="130" width="390" x="1180" y="405" as="geometry" />
        </mxCell>
        <mxCell id="BVQBgyILcWpBfLLa7Rj2-0" parent="TnJXvQ2mKdRsLpWc-1" style="shape=note;size=15;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;html=1;whiteSpace=wrap;" value="&lt;div&gt;void &lt;b&gt;defineDisplayHierarchy(IWidget&amp;amp; pageRoot)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;{&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt; &lt;/span&gt;pageRoot.addChildWidget(backgroundPanel);&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt; &lt;/span&gt;pageRoot.addChildWidget(bottomLinePanel);&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt; &lt;/span&gt;pageRoot.addChildWidget(leftBorderPanel);&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt; &lt;/span&gt;pageRoot.addChildWidget(rightBorderPanel);&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt; &lt;/span&gt;pageRoot.addChildWidget(topBorderPanel);&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt; &lt;/span&gt;pageRoot.addChildWidget(paddlePanel);&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt; &lt;/span&gt;pageRoot.addChildWidget(buttonLeft);&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt; &lt;/span&gt;pageRoot.addChildWidget(buttonRight);&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt; &lt;/span&gt;// De crates vóór de ballen, zodat een bal er overheen gaat en niet&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt; &lt;/span&gt;// erachter verdwijnt op het moment dat hij hem raakt.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt; &lt;/span&gt;for (int i = 0; i &amp;lt; MaxNofCrates; i++)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt; &lt;/span&gt;{&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;  &lt;/span&gt;pageRoot.addChildWidget(arCratePanels[i]);&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt; &lt;/span&gt;}&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt; &lt;/span&gt;for (int i = 0; i &amp;lt; MaxNofFireBins; i++)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt; &lt;/span&gt;{&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;  &lt;/span&gt;pageRoot.addChildWidget(arFireBinPanels[i]);&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt; &lt;/span&gt;}&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt; &lt;/span&gt;for (int i = 0; i &amp;lt; NofScoreDigits; i++)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt; &lt;/span&gt;{&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;  &lt;/span&gt;pageRoot.addChildWidget(arScoreDigitPanels[i]);&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt; &lt;/span&gt;}&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt; &lt;/span&gt;// De ballen als laatste, dus bovenop. Dat is niet alleen mooier bij een&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt; &lt;/span&gt;// kaatsing tegen de peddel: een brandende bal valt onder de doellijn&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt; &lt;/span&gt;// door en komt daarbij over de peddelknoppen heen.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt; &lt;/span&gt;for (int i = 0; i &amp;lt; MaxNofBalls; i++)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt; &lt;/span&gt;{&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;  &lt;/span&gt;pageRoot.addChildWidget(arBallPanels[i]);&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt; &lt;/span&gt;}&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt; &lt;/span&gt;// En het GAME OVER-vignet daar nog overheen.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt; &lt;/span&gt;pageRoot.addChildWidget(buttonGameOverLabel);&lt;/span&gt;&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;" vertex="1">
          <mxGeometry height="590" width="420" x="1180" y="550" as="geometry" />
        </mxCell>
        <mxCell id="r723ki3-5yY8NdxZmrxx-0" parent="TnJXvQ2mKdRsLpWc-1" style="shape=mxgraph.sysml.simpleState;html=1;overflow=fill;whiteSpace=wrap;align=center;" value="&lt;p style=&quot;margin: 0px ; margin-top: 4px ; text-align: center&quot;&gt;Hidden&lt;/p&gt;&lt;hr&gt;&lt;p&gt;&lt;/p&gt;&lt;p style=&quot;margin: 0px ; margin-left: 8px ; text-align: left&quot;&gt;flagDeshowGamePage / .&amp;nbsp; &amp;nbsp;// al uit beeld: niets te doen, flag consumeren.&lt;/p&gt;" vertex="1">
          <mxGeometry height="70" width="420" x="660" y="480" as="geometry" />
        </mxCell>
        <mxCell id="BrvEYYTI_gRzCjXCi2ai-2" parent="TnJXvQ2mKdRsLpWc-1" style="shape=note;size=15;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;html=1;whiteSpace=wrap;" value="&lt;b&gt;Selectie van private functies&lt;/b&gt;&lt;div&gt;&lt;br&gt;Als vuistregel laat je in ieder geval private functies in je STD zien die berichten sturen naar andere objecten uit je object model.&lt;br&gt;&lt;br&gt;Verder (zoals in deze STD) kun je naar believen private functies toevoegen als je vind dat ze iets belangrijks verduidelijken.&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="390" x="640" y="930" as="geometry" />
        </mxCell>
        <mxCell id="std-separator" parent="TnJXvQ2mKdRsLpWc-1" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;" value="" vertex="1">
          <mxGeometry height="8" width="1610" x="20" y="326" as="geometry" />
        </mxCell>
      </root>
