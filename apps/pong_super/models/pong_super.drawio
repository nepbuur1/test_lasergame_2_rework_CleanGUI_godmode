        <mxCell id="TnJXvQ2mKdRsLpWc-3" parent="TnJXvQ2mKdRsLpWc-1" style="shape=mxgraph.sysml.simpleState;html=1;overflow=fill;whiteSpace=wrap;align=center;" value="&lt;p style=&quot;margin: 0px ; margin-top: 4px ; text-align: center&quot;&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;/p&gt;&lt;hr&gt;&lt;p&gt;&lt;/p&gt;&lt;p style=&quot;margin: 0px ; margin-left: 8px ; text-align: left&quot;&gt;updateGameObjects(ballStates, crateStates, fireBinStates, score) /&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;poolBallStates.write(ballStates); poolCrateStates.write(crateStates);&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;poolFireBinStates.write(fireBinStates); poolScore.write(score);&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;flagBallPositionUpdated.set()&lt;br&gt;updatePaddlePosition(x) / poolPaddlePosition.write(x); flagPaddlePositionUpdated.set()&lt;br&gt;showGamePage()        / flagDeshowGamePage.clear(); flagShowGamePage.set()&lt;br&gt;hideGamePage()        / flagShowGamePage.clear(); flagDeshowGamePage.set()&lt;br&gt;showPaddle()          / flagHidePaddle.clear(); flagShowPaddle.set()&lt;br&gt;hidePaddle()          / flagShowPaddle.clear(); flagHidePaddle.set()&lt;br&gt;showGameOverLabel()   / flagHideGameOverLabel.clear(); flagShowGameOverLabel.set()&lt;br&gt;hideGameOverLabel()   / flagShowGameOverLabel.clear(); flagHideGameOverLabel.set()&lt;br&gt;getWidth() / return width;      getHeight() / return height;&lt;br&gt;getBallOffScreenY() / return (height-1) - screenHeight - ballPanelSizePix().y/2;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;// deze drie: geen aanpassing na initialisatie/constructie -&amp;gt; geen synchronisatie nodig&lt;br&gt;&lt;/p&gt;" vertex="1">
