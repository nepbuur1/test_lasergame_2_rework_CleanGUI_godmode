        <mxCell id="TnJXvQ2mKdRsLpWc-10" edge="1" parent="TnJXvQ2mKdRsLpWc-1" source="TnJXvQ2mKdRsLpWc-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="r723ki3-5yY8NdxZmrxx-0" value="flagDeshowGamePage /&lt;br&gt;hidePage(pageGame)">
          <mxGeometry relative="1" x="-0.0631" as="geometry">
            <mxPoint y="-1" as="offset" />
            <Array as="points">
              <mxPoint x="970" y="580" />
              <mxPoint x="970" y="580" />
