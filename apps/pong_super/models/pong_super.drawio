          </mxGeometry>
        </mxCell>
        <mxCell id="fire-update" edge="1" parent="1" source="fire-burning" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;curved=0;" target="fire-after-update" value="&lt;div&gt;/ indexAnimationStep++;&lt;/div&gt;&lt;div&gt;nofStepsLeft--&lt;/div&gt;">
          <mxGeometry relative="1" x="-0.28" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="fire-continue" edge="1" parent="1" source="fire-after-update" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;curved=0;" target="fire-burning" value="[nofStepsLeft &amp;gt; 0]">
          <mxGeometry relative="1" x="-0.0385" y="30" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="800" y="500" />
              <mxPoint x="800" y="345" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="fire-release" edge="1" parent="1" source="fire-after-update" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;curved=0;" target="fire-in-depot" value="&lt;div&gt;[nofStepsLeft &amp;lt;= 0] /&lt;/div&gt;&lt;div&gt;pDepot-&amp;gt;release(indexSlot)&lt;/div&gt;">
          <mxGeometry relative="1" x="-0.36" y="-18" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="340" y="500" />
            </Array>
            <mxPoint x="615" y="495" as="sourcePoint" />
