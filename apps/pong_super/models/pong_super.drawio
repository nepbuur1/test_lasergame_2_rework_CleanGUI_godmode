          <mxGeometry height="150" width="430" x="655" y="670" as="geometry" />
        </mxCell>
        <mxCell id="TnJXvQ2mKdRsLpWc-8" edge="1" parent="TnJXvQ2mKdRsLpWc-1" source="TnJXvQ2mKdRsLpWc-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;align=left;labelBackgroundColor=none;verticalAlign=bottom;" target="r723ki3-5yY8NdxZmrxx-0" value="initPanels();&lt;br&gt;assert(display.isBuffered());&amp;nbsp;&amp;nbsp;&amp;nbsp;// de app rekent op de backbuffer&lt;br&gt;GamePageRoot pageGame(&quot;rootGameDisplay&quot;, display);&lt;br&gt;defineDisplayHierarchy(pageGame);&lt;br&gt;hidePage(pageGame);             // het spel begint op de startpagina">
