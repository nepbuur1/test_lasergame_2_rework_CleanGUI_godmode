        <mxCell id="fire-start" edge="1" parent="1" source="fire-initial" style="endArrow=classic;html=1;rounded=1;align=center;curved=0;" target="fire-in-depot" value="&lt;div&gt;/ posX = 0;&lt;/div&gt;&lt;div&gt;posY = 0;&lt;/div&gt;&lt;div&gt;nofStepsLeft = 0;&lt;/div&gt;&lt;div&gt;indexAnimationStep = 0;&lt;/div&gt;&lt;div&gt;bFlagSpawnAt = false;&lt;/div&gt;&lt;div&gt;spawnAtPosX = 0;&lt;/div&gt;&lt;div&gt;spawnAtPosY = 0;&lt;/div&gt;">
          <mxGeometry relative="1" y="-55" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="fire-spawn" edge="1" parent="1" source="fire-in-depot" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;curved=0;" target="fire-burning" value="&lt;div&gt;[bFlagSpawnAt] /&lt;/div&gt;&lt;div&gt;bFlagSpawnAt = false;&lt;/div&gt;&lt;div&gt;startAt(spawnAtPosX, spawnAtPosY)&lt;/div&gt;">
          <mxGeometry relative="1" y="28" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="390" y="345" />
              <mxPoint x="390" y="345" />
