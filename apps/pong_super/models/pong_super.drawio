        <mxCell id="TnJXvQ2mKdRsLpWc-9" edge="1" parent="TnJXvQ2mKdRsLpWc-1" source="r723ki3-5yY8NdxZmrxx-0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="TnJXvQ2mKdRsLpWc-7" value="flagShowGamePage /&lt;br&gt;showPage(pageGame)">
