  <diagram id="std-cratecontrol-20260823" name="STD CrateControl">
    <mxGraphModel dx="856" dy="1317" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="lwzvWU-ZIPV49mfB-4rG-1" parent="1" style="html=1;shape=mxgraph.sysml.package;overflow=fill;labelX=180;strokeWidth=2;align=center;" value="&lt;p style=&quot;margin:0px;margin-top:4px;margin-left:7px;text-align:left;&quot;&gt;&lt;b&gt;std&lt;/b&gt;  CrateControl - update()&lt;/p&gt;" vertex="1">
          <mxGeometry height="480" width="810" x="10" y="10" as="geometry" />
        </mxCell>
        <mxCell id="lwzvWU-ZIPV49mfB-4rG-2" parent="1" style="shape=mxgraph.sysml.simpleState;html=1;overflow=fill;whiteSpace=wrap;align=center;" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center&quot;&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;/p&gt;&lt;hr&gt;&lt;p style=&quot;margin:0px;margin-left:8px;text-align:left&quot;&gt;spawnAt(posX, posY) / this-&amp;gt;posX = posX; this-&amp;gt;posY = posY; nofHitsLeft = NofCrateHits&amp;nbsp;&amp;nbsp;// direct, same Task&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;text-align:left&quot;&gt;getPosX() / return posX&amp;nbsp;&amp;nbsp;// no Pool, same Task&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;text-align:left&quot;&gt;getPosY() / return posY&amp;nbsp;&amp;nbsp;// no Pool, same Task&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;text-align:left&quot;&gt;isHitAtPos(ballPosX, ballPosY, ballRadius) /&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;text-align:left&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; halfSize = CrateSizePix/2; dx = abs(ballPosX-posX); dy = abs(ballPosY-posY);&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;text-align:left&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; return (dx &amp;lt; halfSize + ballRadius) &amp;amp;&amp;amp; (dy &amp;lt; halfSize + ballRadius)&amp;nbsp;&amp;nbsp;// direct call, same Task&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;text-align:left&quot;&gt;wasHit() / if (nofHitsLeft &amp;gt; 0) nofHitsLeft--; if (!isOpened()) return;&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (pBallSpawner != nullptr) pBallSpawner-&amp;gt;spawnBallsAt(posX, posY, NofBallsPerCrate);&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; assert(pDepot != nullptr); pDepot-&amp;gt;release(indexSlot);&amp;nbsp;&amp;nbsp;// direct call, same Task&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;text-align:left&quot;&gt;isOpened() / return (nofHitsLeft &amp;lt;= 0)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;text-align:left&quot;&gt;getCrateState() / return CrateState(posX, posY, nofHitsLeft)&amp;nbsp;&amp;nbsp;// no Pool, same Task&lt;/p&gt;" vertex="1">
          <mxGeometry height="210" width="720" x="55" y="40" as="geometry" />
        </mxCell>
        <mxCell id="lwzvWU-ZIPV49mfB-4rG-3" parent="1" style="shape=note;size=15;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;html=1;whiteSpace=wrap;" value="&lt;div&gt;&lt;b&gt;Update() calls / Handler Pattern&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Depot calls update() while the slot is in use; update() currently has no behaviour. wasHit() is handled immediately inside the BallControl update and therefore in the same Task.&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="350" x="55" y="280" as="geometry" />
        </mxCell>
        <mxCell id="lwzvWU-ZIPV49mfB-4rG-4" parent="1" style="shape=note;size=15;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;html=1;whiteSpace=wrap;" value="&lt;div&gt;&lt;b&gt;State representation&lt;/b&gt;&lt;/div&gt;&lt;div&gt;There is no State member. The lifecycle state follows ownership of the Depot slot; nofHitsLeft is the progress within Closed.&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="350" x="55" y="380" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
