          <mxGeometry height="40" width="40" x="40" y="325" as="geometry" />
        </mxCell>
        <mxCell id="fire-in-depot" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="InDepot" vertex="1">
          <mxGeometry height="70" width="120" x="280" y="310" as="geometry" />
        </mxCell>
        <mxCell id="fire-burning" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Burning" vertex="1">
          <mxGeometry height="70" width="130" x="640" y="310" as="geometry" />
        </mxCell>
        <mxCell id="fire-after-update" parent="1" style="rhombus;whiteSpace=wrap;html=1;" value="" vertex="1">
