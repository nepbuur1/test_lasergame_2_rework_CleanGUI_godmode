        <mxCell id="ball-movestep-note" parent="1" style="shape=note;size=15;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;html=1;whiteSpace=wrap;" value="&lt;div&gt;&lt;b&gt;moveStep()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;posX += vX; posY += vY;&lt;/div&gt;&lt;div&gt;bounceOffWallsIfHit();&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;paddlePosition = pBallCollisionCheck-&amp;gt;getPaddlePosition();&lt;/div&gt;&lt;div&gt;if (bouncePaddleIfHit(paddlePosition))&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;pBallListener-&amp;gt;ballBouncedOnPaddle();&amp;nbsp; &amp;nbsp; // notify for score+=1&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;CrateHit hit = pBallCollisionCheck-&amp;gt;getCrateHitAtPos(posX,posY,ballRadius);&lt;/div&gt;&lt;div&gt;if (hit.bHit)&lt;/div&gt;&lt;div&gt;{&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;pBallCollisionCheck-&amp;gt;crateWasHitAtPos(hit);&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;bounceOffCrate(hit);&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;if (state == STATE_RUNNING &amp;amp;&amp;amp; pBallCollisionCheck-&amp;gt;isFireBinTouchedAtPos&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; (posX,posY,ballRadius))&lt;/div&gt;&lt;div&gt;{&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;nofBurnUpClockStepsLeft = NofBallBurnUpSteps;&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;indexBurnAnimationStep = 0;&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;state = STATE_BURNING_UP;&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;" vertex="1">
          <mxGeometry height="345" width="460" x="350" y="750" as="geometry" />
        </mxCell>
        <mxCell id="ball-state-note" parent="1" style="shape=note;size=15;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;html=1;whiteSpace=wrap;" value="&lt;div&gt;&lt;b&gt;State meaning&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Idle: In the depot; no active state is published.&lt;/div&gt;&lt;div&gt;Running: Normal movement and collisions.&lt;/div&gt;&lt;div&gt;BurningUp: Still collides; ends when its burn clock expires.&lt;/div&gt;&lt;div&gt;FallingOut: Burns and falls without collisions; ends off-screen.&lt;/div&gt;" vertex="1">
          <mxGeometry height="125" width="316" x="24" y="850" as="geometry" />
        </mxCell>
        <mxCell id="hXAVik4KtP5QGc_tJwIm-1" parent="1" style="shape=note;size=15;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;html=1;whiteSpace=wrap;" value="&lt;div&gt;&lt;b&gt;Update() calls / Handler Pattern&lt;/b&gt;&lt;/div&gt;&lt;div&gt;BallControl receives update() calls from a Handler.&lt;br&gt;So rather than contintuously, only on every update() call, the conditions for evaluating the current state are evaluated.&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="316" x="24" y="750" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
