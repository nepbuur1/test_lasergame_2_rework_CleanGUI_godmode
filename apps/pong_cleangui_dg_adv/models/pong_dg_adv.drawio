      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="fire-frame" parent="1" style="html=1;shape=mxgraph.sysml.package;overflow=fill;labelX=190;strokeWidth=2;align=center;" value="&lt;p style=&quot;margin:0px;margin-top:4px;margin-left:7px;text-align:left;&quot;&gt;&lt;b&gt;std&lt;/b&gt;  FireBinControl - update()&lt;/p&gt;" vertex="1">
          <mxGeometry height="770" width="810" x="10" y="10" as="geometry" />
        </mxCell>
        <mxCell id="fire-interface" parent="1" style="shape=mxgraph.sysml.simpleState;html=1;overflow=fill;whiteSpace=wrap;align=center;" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center&quot;&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;/p&gt;&lt;hr&gt;&lt;p style=&quot;margin:0px;margin-left:8px;text-align:left&quot;&gt;spawnAt(posX, posY) / spawnAtPosX = posX; spawnAtPosY = posY; bFlagSpawnAt = true&amp;nbsp;&amp;nbsp;// no Pool, no Flag, same Task&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;text-align:left&quot;&gt;reset() /&amp;nbsp;&lt;span style=&quot;background-color: transparent;&quot;&gt;posX = 0;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;posY = 0;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;nofStepsLeft = 0;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;indexAnimationStep = 0;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;bFlagSpawnAt = false;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;spawnAtPosX = 0;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;spawnAtPosY = 0;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;text-align:left&quot;&gt;getPosX() / return posX&amp;nbsp;&amp;nbsp;// no Pool, same Task&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;text-align:left&quot;&gt;getPosY() / return posY&amp;nbsp;&amp;nbsp;// no Pool, same Task&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;text-align:left&quot;&gt;isTouchedAtPos(ballPosX, ballPosY, ballRadius) /&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;text-align:left&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if (state != STATE_BURNING) return false;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;text-align:left&quot;&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;span style=&quot;background-color: transparent;&quot;&gt;int halfSize = FireBinSizePix/2&lt;/span&gt;&lt;span style=&quot;background-color: transparent; white-space: pre;&quot;&gt;&#x9;&#x9;&#x9;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;text-align:left&quot;&gt;&amp;nbsp; &amp;nbsp; int dx = (ballPosX &amp;gt; posX) ? (ballPosX - posX) : (posX - ballPosX);&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&#x9;&#x9;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;text-align:left&quot;&gt;&amp;nbsp; &amp;nbsp; int dy = (ballPosY &amp;gt; posY) ? (ballPosY - posY) : (posY - ballPosY);&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;text-align:left&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&amp;nbsp; &amp;nbsp; return (dx &amp;lt; halfSize + ballRadius) &amp;amp;&amp;amp; (dy &amp;lt; halfSize + ballRadius); /&lt;/span&gt;/ direct call, same Task&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;text-align:left&quot;&gt;getFireBinState() /&amp;nbsp;&lt;span style=&quot;background-color: transparent;&quot;&gt;if (state != STATE_BURNING)&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;{&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;return FireBinState();&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;}&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;text-align:left&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; else&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;return FireBinState(posX, posY, indexAnimationStep);&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;&amp;nbsp;// no Pool, same Task&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="210" width="740" x="45" y="40" as="geometry" />
        </mxCell>
