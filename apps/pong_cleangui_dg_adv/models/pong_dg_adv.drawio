        <mxCell id="fire-handler-note" parent="1" style="shape=note;size=15;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;html=1;whiteSpace=wrap;" value="&lt;div&gt;&lt;b&gt;Update() calls / Handler Pattern&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Depot calls update() only while the slot is in use. InDepot evaluates bFlagSpawnAt; Burning advances animation and lifetime. No waitable is used: the calls share one Task and update() never blocks.&lt;/div&gt;" vertex="1">
          <mxGeometry height="105" width="350" x="24" y="545" as="geometry" />
        </mxCell>
        <mxCell id="fire-state-note" parent="1" style="shape=note;size=15;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;html=1;whiteSpace=wrap;" value="&lt;div&gt;&lt;b&gt;State meaning&lt;/b&gt;&lt;/div&gt;&lt;div&gt;InDepot: No active FireBinState is published. While the slot is obtained, each update() evaluates bFlagSpawnAt.&lt;/div&gt;&lt;div&gt;Burning: The fire bin is visible, animated and counting down.&lt;/div&gt;" vertex="1">
          <mxGeometry height="105" width="270" x="515" y="650" as="geometry" />
        </mxCell>
        <mxCell id="fire-state-representation-note" parent="1" style="shape=note;size=15;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;html=1;whiteSpace=wrap;" value="&lt;div&gt;&lt;b&gt;Depot Release&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Depot::release() and releaseAll() call reset(), which clears per-life runtime data.&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="216" x="390" y="545" as="geometry" />
        </mxCell>
