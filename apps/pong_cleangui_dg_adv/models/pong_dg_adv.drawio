        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="crate-frame" parent="1" style="html=1;shape=mxgraph.sysml.package;overflow=fill;labelX=180;strokeWidth=2;align=center;" value="&lt;p style=&quot;margin:0px;margin-top:4px;margin-left:7px;text-align:left;&quot;&gt;&lt;b&gt;std&lt;/b&gt;  CrateControl - update()&lt;/p&gt;" vertex="1">
          <mxGeometry height="770" width="810" x="10" y="10" as="geometry" />
        </mxCell>
        <mxCell id="crate-interface" parent="1" style="shape=mxgraph.sysml.simpleState;html=1;overflow=fill;whiteSpace=wrap;align=center;" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center&quot;&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;/p&gt;&lt;hr&gt;&lt;p style=&quot;margin:0px;margin-left:8px;text-align:left&quot;&gt;spawnAt(posX, posY) / this-&amp;gt;posX = posX; this-&amp;gt;posY = posY; nofHitsLeft = NofCrateHits&amp;nbsp;&amp;nbsp;// direct, same Task&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;text-align:left&quot;&gt;getPosX() / return posX&amp;nbsp;&amp;nbsp;// no Pool, same Task&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;text-align:left&quot;&gt;getPosY() / return posY&amp;nbsp;&amp;nbsp;// no Pool, same Task&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;text-align:left&quot;&gt;isHitAtPos(ballPosX, ballPosY, ballRadius) /&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;text-align:left&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; halfSize = CrateSizePix/2; dx = abs(ballPosX-posX); dy = abs(ballPosY-posY);&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;text-align:left&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; return (dx &amp;lt; halfSize + ballRadius) &amp;amp;&amp;amp; (dy &amp;lt; halfSize + ballRadius)&amp;nbsp;&amp;nbsp;// direct call, same Task&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;text-align:left&quot;&gt;wasHit() / decrement nofHitsLeft; when opened, spawn NofBallsPerCrate balls and release this slot&amp;nbsp;&amp;nbsp;// direct call, same Task&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;text-align:left&quot;&gt;isOpened() / return (nofHitsLeft &amp;lt;= 0)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;text-align:left&quot;&gt;getCrateState() / return CrateState(posX, posY, nofHitsLeft)&amp;nbsp;&amp;nbsp;// no Pool, same Task&lt;/p&gt;" vertex="1">
          <mxGeometry height="180" width="720" x="55" y="40" as="geometry" />
        </mxCell>
        <mxCell id="crate-divider" edge="1" parent="1" style="endArrow=none;html=1;rounded=1;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="10" y="240" as="sourcePoint" />
            <mxPoint x="820" y="240" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="crate-initial" parent="1" style="shape=ellipse;html=1;fillColor=#000000;fontSize=18;fontColor=#ffffff;" value="" vertex="1">
          <mxGeometry height="40" width="40" x="40" y="295" as="geometry" />
        </mxCell>
        <mxCell id="crate-in-depot" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="InDepot" vertex="1">
          <mxGeometry height="70" width="120" x="110" y="280" as="geometry" />
        </mxCell>
        <mxCell id="crate-closed" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Closed" vertex="1">
          <mxGeometry height="70" width="130" x="550" y="280" as="geometry" />
        </mxCell>
        <mxCell id="crate-after-hit" parent="1" style="rhombus;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="40" width="40" x="595" y="460" as="geometry" />
        </mxCell>
        <mxCell id="crate-start" edge="1" parent="1" source="crate-initial" style="endArrow=classic;html=1;rounded=1;align=center;curved=0;" target="crate-in-depot" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="crate-spawn" edge="1" parent="1" source="crate-in-depot" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;curved=0;" target="crate-closed" value="&lt;div&gt;spawnAt(posX, posY) /&lt;/div&gt;&lt;div&gt;this-&amp;gt;posX = posX; this-&amp;gt;posY = posY;&lt;/div&gt;&lt;div&gt;nofHitsLeft = NofCrateHits&lt;/div&gt;">
          <mxGeometry relative="1" y="28" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="390" y="315" />
              <mxPoint x="390" y="315" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="crate-hit" edge="1" parent="1" source="crate-closed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;curved=0;" target="crate-after-hit" value="&lt;div&gt;wasHit() /&lt;/div&gt;&lt;div&gt;if (nofHitsLeft &amp;gt; 0) nofHitsLeft--&lt;/div&gt;">
          <mxGeometry relative="1" x="-0.27" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="crate-remains-closed" edge="1" parent="1" source="crate-after-hit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;curved=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" target="crate-closed" value="[!isOpened()]">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="750" y="480" />
              <mxPoint x="750" y="315" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="crate-open" edge="1" parent="1" source="crate-after-hit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;curved=0;" target="crate-in-depot" value="&lt;div&gt;[isOpened()] /&lt;/div&gt;&lt;div&gt;if (pBallSpawner != nullptr)&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;pBallSpawner-&amp;gt;spawnBallsAt(posX, posY, NofBallsPerCrate);&lt;/div&gt;&lt;div&gt;pDepot-&amp;gt;release(indexSlot)&lt;/div&gt;">
          <mxGeometry relative="1" x="-0.25" y="-28" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="170" y="480" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="crate-handler-note" parent="1" style="shape=note;size=15;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;html=1;whiteSpace=wrap;" value="&lt;div&gt;&lt;b&gt;Update() calls / Handler Pattern&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Depot calls update() while the slot is in use; update() currently has no behaviour. wasHit() is handled immediately inside the BallControl update and therefore in the same Task.&lt;/div&gt;" vertex="1">
          <mxGeometry height="115" width="350" x="24" y="530" as="geometry" />
        </mxCell>
        <mxCell id="crate-state-note" parent="1" style="shape=note;size=15;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;html=1;whiteSpace=wrap;" value="&lt;div&gt;&lt;b&gt;State meaning&lt;/b&gt;&lt;/div&gt;&lt;div&gt;InDepot: The slot is not in use; no update or state is published.&lt;/div&gt;&lt;div&gt;Closed: The crate is visible and waiting for hits.&lt;/div&gt;&lt;div&gt;Opened is not a persistent state: balls are spawned and the slot is released within the same wasHit() call.&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="420" x="390" y="530" as="geometry" />
        </mxCell>
        <mxCell id="crate-state-representation-note" parent="1" style="shape=note;size=15;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;html=1;whiteSpace=wrap;" value="&lt;div&gt;&lt;b&gt;State representation&lt;/b&gt;&lt;/div&gt;&lt;div&gt;There is no State member. The lifecycle state follows ownership of the Depot slot; nofHitsLeft is the progress within Closed.&lt;/div&gt;" vertex="1">
          <mxGeometry height="95" width="350" x="24" y="660" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
