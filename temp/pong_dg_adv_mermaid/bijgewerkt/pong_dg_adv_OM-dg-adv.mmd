    %% Objecten
    startPageControl["«control»<br>startPageControl"]
    buttonSpStart["«boundary»<br>buttonSpStart"]
    startPageDisplayControl["«isActive»<br>«boundary»<br>startPageDisplayControl"]
    buttonGoStart["«boundary»<br>buttonGoStart"]
    mainControl["«isActive»<br>«control»<br>mainControl"]
    gameOverPageControl["«control»<br>gameOverPageControl"]
    gameOverDisplayControl["«isActive»<br>«boundary»<br>gameOverDisplayControl"]
    hallOfFame["«entity»<br>hallOfFame"]
    nameInputControl["«boundary»<br>nameInputControl"]
    nameInputfield["«boundary»<br>nameInputfield"]
    crateControl["«control»<br>crateControl"]
    ballControl["«control»<br>ballControl"]
    spawnables["«entity»<br>spawnables"]
    fireBinControl["«control»<br>fireBinControl"]
    gameControl["«control»<br>gameControl"]
    buttonGameOverLabel["«boundary»<br>buttonGameOverLabel"]
    paddleControl["«isActive»<br>«control»<br>paddleControl"]
    gameDisplayControl["«isActive»<br>«boundary»<br>gameDisplayControl"]
    buttonLeft["«boundary»<br>buttonLeft"]
    buttonRight["«boundary»<br>buttonRight"]
