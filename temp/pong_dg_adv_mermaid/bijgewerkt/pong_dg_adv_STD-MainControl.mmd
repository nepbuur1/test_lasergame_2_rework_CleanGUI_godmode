---
title: "std MainControl - met ButtonInfo-pagina (nieuw in groen)"
config:
  theme: base
  themeCSS: "& { background-color: #ffffff; }"
  themeVariables:
    background: "#ffffff"
    mainBkg: "#ffffff"
    primaryColor: "#ffffff"
    primaryTextColor: "#000000"
    primaryBorderColor: "#333333"
    nodeBorder: "#333333"
    textColor: "#000000"
    nodeTextColor: "#000000"
    titleColor: "#000000"
    classText: "#000000"
    lineColor: "#333333"
    edgeLabelBackground: "#ffffff"
    noteBkgColor: "#fff9c4"
    noteTextColor: "#000000"
    noteBorderColor: "#9e9e9e"
---
stateDiagram-v2
    direction TB
    %% Toestanden
    state "WaitForAdcButtons" as WaitForAdcButtons
    state "ButtonInfoPage" as ButtonInfoPage
    ButtonInfoPage : do / buttonInfoControl.doButtonInfoPage()
    state "StartPage" as StartPage
    StartPage : do / startPageControl.doStartPage()
    state "GameRunning" as GameRunning
    GameRunning : do / gameControl.doGame()
    state "GameOver" as GameOver
    GameOver : do / gameOverControl.doGameOver()

    %% Transities
    [*] --> WaitForAdcButtons
    WaitForAdcButtons --> ButtonInfoPage : after(200ms)
    ButtonInfoPage --> StartPage
    StartPage --> GameRunning
    GameRunning --> GameOver
    GameOver --> StartPage

    classDef nieuw fill:#ffffff,stroke:#2e7d32,stroke-width:2px,color:#2e7d32
    class WaitForAdcButtons,ButtonInfoPage nieuw
