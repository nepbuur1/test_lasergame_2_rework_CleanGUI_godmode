    state "Showing" as Showing
    Showing : timerTorch / selectNextAnimationFrameOfTorches()#59;
    Showing : pageStart.show(true)#59;
    Showing : timerTorch.start(TorchesDisplayHelpers#58;#58;nextTorchIntervalUs())

    %% Transities
    [*] --> Hidden : initPanels()#59; // background, title, credits,<br>buttonStart, torches<br>PageRoot#lt;20#gt; pageStart(#quot;rootStartPageDisplay#quot;,display)#59;<br>defineDisplayHierarchy(pageStart)#59;<br>hidePage(pageStart)
    Hidden --> Showing : flagShowStartPage /<br>showPage(pageStart)#59;<br>timerTorch.start(TorchesDisplayHelpers#58;#58;nextTorchIntervalUs())
    Showing --> Hidden : flagHideStartPage<br>/ timerTorch.stop()#59;<br>hidePage(pageStart)
