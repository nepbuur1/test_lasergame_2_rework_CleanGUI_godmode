flowchart LR
    %% Objecten
    startPageControl["«control»<br>startPageControl"]
    buttonSpStart["«boundary»<br>buttonSpStart"]
    startPageDisplayControl["«control»<br>startPageDisplayControl"]
    buttonGoStart["«boundary»<br>buttonGoStart"]
    mainControl["«control»<br>mainControl"]
    gameOverControl["«control»<br>gameOverControl"]
    gameOverDisplayControl["«control»<br>gameOverDisplayControl"]
    displayAdapter["«boundary»<br>displayAdapter"]
    ballControl["«control»<br>ballControl"]
    gameDisplayControl["«control»<br>gameDisplayControl"]
    gameControl["«control»<br>gameControl"]
    buttonLeft["«boundary»<br>buttonLeft"]
    buttonRight["«boundary»<br>buttonRight"]
    paddleControl["«control»<br>paddleControl"]

    %% Berichten
    startPageControl -->|"showStartPage,<br>hideStartPage"| startPageDisplayControl
    buttonSpStart -->|"buttonPressed(pButton)"| startPageControl
    startPageDisplayControl -->|"..."| displayAdapter
    buttonGoStart -->|"buttonPressed(pButton)"| gameOverControl
    mainControl -->|"doStartPage"| startPageControl
    mainControl -->|"doGameOver"| gameOverControl
    mainControl -->|"doGame"| gameControl
    gameOverControl -->|"showGameOverPage,<br>hideGameOverPage"| gameOverDisplayControl
    gameOverDisplayControl -->|"..."| displayAdapter
    ballControl -->|"getSize,<br>ballPosUpdated(x,y)"| gameDisplayControl
    ballControl -->|"ballMissedByPaddle"| gameControl
    ballControl -->|"getPaddlePos"| paddleControl
    gameDisplayControl -->|"..."| displayAdapter
    gameControl -->|"startBall"| ballControl
    gameControl -->|"showGamePage,<br>hideGamePage"| gameDisplayControl
    gameControl -->|"enable,<br>disable"| paddleControl
    buttonLeft -->|"buttonPressed(pButton)"| paddleControl
    buttonRight -->|"buttonPressed(pButton)"| paddleControl
    paddleControl -->|"getSize,<br>paddlePosUpdated(x),<br>showPaddles"| gameDisplayControl

    %% Notes
    note_1["Note: calls starting with #quot;do#quot; imply union of<br>tasks, in this case based on control cohesion"]:::note

    classDef default fill:#ffffff,stroke:#333333,color:#000000
    linkStyle default stroke:#333333,color:#000000
    classDef note fill:#fff9c4,stroke:#9e9e9e,stroke-dasharray:4 3,color:#000000
