stateDiagram-v2
    direction TB
    %% Toestanden
    state "«interface»" as interface
    interface : buttonPressed(IButton* pButton) / if(pButton == pStartPageStartButton) flagStartPressed.set()
    state "WaitForStart" as WaitForStart

    %% Transities
    [*] --> WaitForStart : / startPageDisplayControl.showStartPage()#59;<br>flagStartPressed.clear()
