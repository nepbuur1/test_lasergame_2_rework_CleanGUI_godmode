---
title: "std GameControl - doGame()"
config:
  theme: base
  themeCSS: "& { background-color: #ffffff; }"
  themeVariables:
    background: "#ffffff"
    mainBkg: "#ffffff"
    primaryColor: "#ffffff"
    primaryTextColor: "#000000"
    primaryBorderColor: "#333333"
    nodeBorder: "#333333"
    textColor: "#000000"
    nodeTextColor: "#000000"
    titleColor: "#000000"
    classText: "#000000"
    lineColor: "#333333"
    edgeLabelBackground: "#ffffff"
    noteBkgColor: "#fff9c4"
    noteTextColor: "#000000"
    noteBorderColor: "#9e9e9e"
---
stateDiagram-v2
    direction TB
    %% Toestanden
    state "«interface»" as interface
    interface : getScore / return score // Pool not needed, because called from MainControl (same Task)
    interface : ballBouncedOnPaddle / score++ // Pool not needed, because called from BallControl (same Task).
    interface : buttonPressed(pButton) / if(pButton==pGameOverLabel) flagFrameOverLabelPressed.set()
    state "Running" as Running
    state choice1 <<choice>>
    state "ShowingGameOverLabel" as ShowingGameOverLabel
    state choice2 <<choice>>
    state choice3 <<choice>>
    state choice4 <<choice>>

    %% Transities
    [*] --> Running : gameDisplayControl.showGamePage()#59;<br>score = 0#59;<br>nofFramesUntilSpawn = NofFramesPerSpawnInterval#59;<br>paddleControl.enable()#59;<br>spawnables.spawnBallInTheMiddle()#59;<br>timerFrame.start_periodic(FrameIntervalMs * 1000)#59;
    Running --> choice2 : timerFrame /<br>spawnables.setPaddlePosition<br>(paddleControl.getPaddlePosition())#59;<br>spawnables.updateCratesAndFireBins()#59;<br>spawnables.updateBalls()#59;<br>spawnables.publishStates(score)#59;<br>nofBallsInUse = spawnables.getNofBallsInuse()#59;
    choice1 --> Running
    ShowingGameOverLabel --> choice4 : flagGameOverLabelPressed
    ShowingGameOverLabel --> choice4 : timerGameOverLabel
    choice2 --> ShowingGameOverLabel : [nofBallsInUse==0] /<br>timerFrame.stop()#59;<br>timerFrame.clear()#59;<br>spawnables.releaseCratesAndFireBins()#59;<br>spawnables.publishStates(score)#59;<br>paddleControl.disable()#59;<br>flagGameOverLabelPressed.clear()#59;<br>gameDisplayControl.showGameOverLabel()#59;<br>timeGameOverLabel.start(GameOverLabelTimeoutMs * 1000)
    choice2 --> choice3 : /nofFramesUntilSpawn--
    choice3 --> choice1 : [else]
    choice3 --> choice1 : [nofFramesUntilSpawn #lt;=0]<br>/ nofFramesUntilSpawn=NofFramesPerSpawnInterval#59;<br>spawnObject()
    choice4 --> [*] : flagGameOverLabelPressed.clear()#59;<br>timerGameOverLabel.stop()#59;<br>timerGameOverLabel.clear()#59;<br>gameDisplayControl.hideGameOverLabel()#59;<br>gameDisplayControl.hideGamePage()#59;

    %% Notes
    state "void spawnObject()" as note1
    note1 : #123;
    note1 : int posX, posY#59;
    note1 : pickRandomSpawnPosition(posX, posY)#59;
    note1 : bool bFireBin = (nofBalls #gt;= NofBallsForCertainFireBin) ||
    note1 : ((int)(rand() #37; NofBallsForCertainFireBin) #lt; nofBalls)#59;
    note1 : if (bFireBin)
    note1 : #123;
    note1 : spawnables.spawnFireBinAt(posX, posY)#59;
    note1 : #125;
    note1 : else
    note1 : #123;
    note1 : spawnables.spawnCrateAt(posX, posY)#59;
    note1 : #125;
    note1 : #125;
    classDef noteBlock fill:#fff9c4,stroke:#9e9e9e,color:#000000
    class note1 noteBlock
