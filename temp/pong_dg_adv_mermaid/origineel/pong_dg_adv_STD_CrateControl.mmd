stateDiagram-v2
    direction TB
    %% Toestanden
    state "«interface»" as interface
    interface : spawnAt(posX, posY) / this-#gt;posX = posX#59; this-#gt;posY = posY#59; nofHitsLeft =
    interface : #nbsp;#nbsp;#nbsp;#nbsp;NofCrateHits // direct, same Task
    interface : getPosX() / return posX // no Pool, same Task
    interface : getPosY() / return posY // no Pool, same Task
    interface : isHitAtPos(ballPosX, ballPosY, ballRadius) /
    interface : halfSize = CrateSizePix/2#59; dx = abs(ballPosX-posX)#59; dy = abs(ballPosY-posY)#59;
    interface : return (dx #lt; halfSize + ballRadius) #amp;#amp; (dy #lt; halfSize + ballRadius) // direct call, same Task
    interface : wasHit() / decrement nofHitsLeft#59; when opened, spawn NofBallsPerCrate balls and
    interface : #nbsp;#nbsp;#nbsp;#nbsp;release this slot // direct call, same Task
    interface : isOpened() / return (nofHitsLeft #lt;= 0)
    interface : getCrateState() / return CrateState(posX, posY, nofHitsLeft) // no Pool, same Task
    state "InDepot" as InDepot
    state "Closed" as Closed
    state choice1 <<choice>>

    %% Transities
    [*] --> InDepot
    InDepot --> Closed : spawnAt(posX, posY) /<br>this-#gt;posX = posX#59; this-#gt;posY = posY#59;<br>nofHitsLeft = NofCrateHits
    Closed --> choice1 : wasHit() /<br>if (nofHitsLeft #gt; 0) nofHitsLeft--
    choice1 --> InDepot : [isOpened()] /<br>if (pBallSpawner != nullptr)<br>pBallSpawner-#gt;spawnBallsAt(posX, posY, NofBallsPerCrate)#59;<br>pDepot-#gt;release(indexSlot)
    choice1 --> Closed : [!isOpened()]

    %% Notes
    state "Update() calls / Handler Pattern" as note1
    note1 : Depot calls update() while the slot is in use#59; update() currently has no
    note1 : #nbsp;#nbsp;#nbsp;#nbsp;behaviour. wasHit() is handled immediately inside the BallControl update and
    note1 : #nbsp;#nbsp;#nbsp;#nbsp;therefore in the same Task.
    state "State meaning" as note2
    note2 : InDepot#58; The slot is not in use#59; no update or state is published.
    note2 : Closed#58; The crate is visible and waiting for hits.
    note2 : Opened is not a persistent state#58; balls are spawned and the slot is released
    note2 : #nbsp;#nbsp;#nbsp;#nbsp;within the same wasHit() call.
    state "State representation" as note3
    note3 : There is no State member. The lifecycle state follows ownership of the Depot
    note3 : #nbsp;#nbsp;#nbsp;#nbsp;slot#59; nofHitsLeft is the progress within Closed.
    classDef noteBlock fill:#fff9c4,stroke:#9e9e9e,color:#000000
    class note1,note2,note3 noteBlock
