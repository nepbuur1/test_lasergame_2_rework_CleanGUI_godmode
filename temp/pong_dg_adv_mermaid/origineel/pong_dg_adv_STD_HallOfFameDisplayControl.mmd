---
stateDiagram-v2
    direction TB
    %% Toestanden
    state "«interface»" as interface
    interface : showHallOfFamePage / flagHideHallOfFamePage.clear()#59;
    interface : flagShowHallOfFamePage.set()#59;
    interface : hideHallOfFamePage / flagShowHallOfFamePage.clear()#59;
    interface : flagHideHallOfFamePage.set()#59;
    state "Hidden" as Hidden
    state "Shown" as Shown
    Shown : timerTorch / selectNextAnimationFrameOfTorches()#59;
    Shown : pageHallOfFame.show(true)#59;
    Shown : timerTorch.start(TorchesDisplayHelpers#58;#58;nextTorchIntervalUs())

    %% Transities
    [*] --> Hidden : initPanels()#59;<br>PageRoot#lt;18#gt; pageHallOfFame(#quot;rootHallOfFamePageDisplay#quot;,display)#59;<br>defineDisplayHierarchy(pageHallOfFame)#59;<br>hidePage(pageHallofFame)
    Hidden --> Shown : flagShowHallOfFamePage /<br>showPage(pageHallOfFame)#59;<br>timerTorch.start(TorchesDisplayHelpers#58;#58;nextTorchIntervalUs())
    Shown --> Hidden : flagHideHallOfFamePage<br>/ timerTorch.stop()#59;<br>hidePage(pageHallOfFame)
