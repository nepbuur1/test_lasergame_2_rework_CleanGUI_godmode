---
title: "std HallOfFameDisplayControl"
config:
  theme: base
  themeCSS: "& { background-color: #ffffff; }"
  themeVariables:
    background: "#ffffff"
    mainBkg: "#ffffff"
    primaryColor: "#ffffff"
    primaryTextColor: "#000000"
    primaryBorderColor: "#333333"
    nodeBorder: "#333333"
    textColor: "#000000"
    nodeTextColor: "#000000"
    titleColor: "#000000"
    classText: "#000000"
    lineColor: "#333333"
    edgeLabelBackground: "#ffffff"
    noteBkgColor: "#fff9c4"
    noteTextColor: "#000000"
