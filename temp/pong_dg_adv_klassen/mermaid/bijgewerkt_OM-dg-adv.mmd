    %% Objecten
    startPageControl["«control»<br>startPageControl"]
    buttonStart["«boundary»<br>buttonStart"]
    startPageDisplayControl["«isActive»<br>«boundary»<br>startPageDisplayControl"]
    buttonPlayAgain["«boundary»<br>buttonPlayAgain"]
    mainControl["«isActive»<br>«control»<br>mainControl"]
    gameOverControl["«control»<br>gameOverControl"]
    hallOfFameDisplayControl["«isActive»<br>«boundary»<br>hallOfFameDisplayControl"]
    hallOfFame["«entity»<br>hallOfFame"]
    buttonInfoControl["«control»<br>buttonInfoControl"]
    buttonInfoDisplayControl["«isActive»<br>«boundary»<br>buttonInfoDisplayControl"]
    nameInputControl["«control»<br>nameInputControl"]
    nameInputDisplayControl["«isActive»<br>«boundary»<br>nameInputDisplayControl"]
    buttonContinue["«boundary»<br>buttonContinue"]
    inputfield["«boundary»<br>inputfield"]
    crateControl["«control»<br>crateControl"]
    ballControl["«control»<br>ballControl"]
    spawnables["«entity»<br>spawnables"]
    fireBinControl["«control»<br>fireBinControl"]
    gameControl["«control»<br>gameControl"]
    buttonGameOverLabel["«boundary»<br>buttonGameOverLabel"]
    adcButtons["«isActive»<br>«boundary»<br>adcButtons"]
    paddleControl["«isActive»<br>«control»<br>paddleControl"]
    gameDisplayControl["«isActive»<br>«boundary»<br>gameDisplayControl"]
    buttonLeft["«boundary»<br>buttonLeft"]
    buttonRight["«boundary»<br>buttonRight"]

    %% Berichten
    startPageControl -->|"showStartPage,<br>hideStartPage"| startPageDisplayControl
    buttonStart -->|"buttonPressed(pButton)"| startPageControl
    buttonPlayAgain -->|"buttonPressed(pButton)"| gameOverControl
    mainControl -->|"doStartPage"| startPageControl
    mainControl -->|"doGameOver(score)"| gameOverControl
    mainControl -->|"doButtonInfoPage"| buttonInfoControl
    mainControl -->|"doGame,<br>getScore"| gameControl
    gameOverControl -->|"showHallOfFamePage(hallOfFameData),<br>hideHallOfFamePage"| hallOfFameDisplayControl
    gameOverControl -->|"isQualifyingScore(score),<br>insert(strName,score),<br>save,<br>getHallOfFameData"| hallOfFame
    gameOverControl -->|"doQueryName(strName,nofCharsMax)"| nameInputControl
    hallOfFameDisplayControl -->|"getEntry(index)"| hallOfFame
    buttonInfoControl -->|"showButtonInfoPage(bConnected),<br>hideButtonInfoPage"| buttonInfoDisplayControl
    buttonInfoControl -->|"isConnected"| adcButtons
    nameInputControl -->|"showNameInputPage,<br>hideNameInputPage"| nameInputDisplayControl
    nameInputControl -->|"getTextValue(strName)"| inputfield
    nameInputDisplayControl -->|"nameInputPageHidden"| nameInputControl
    nameInputDisplayControl -->|"clearInput"| inputfield
    buttonContinue -->|"buttonPressed(pButton)"| buttonInfoControl
    inputfield -->|"inputNewKey(pInputfield,strKey),<br>inputfieldPressed(pInputfield),<br>outsideInputfieldPressed(pInputfield)"| nameInputControl
    inputfield -->|"inputNewKey(pInputfield,strKey),<br>inputfieldPressed(pInputfield),<br>outsideInputfieldPressed(pInputfield)"| nameInputDisplayControl
    crateControl -->|"spawnBallsAt(x,y,nofBalls)"| spawnables
    ballControl -->|"getCrateHitAtPos(x,y,ballRadius),<br>crateWasHitAtPos(crateHit),<br>isFireBinTouchedAtPos(x,y,ballRadius),<br>getPaddlePosition"| spawnables
    ballControl -->|"ballBouncedOnPaddle"| gameControl
    ballControl -->|"getWidth,<br>getHeight,<br>getBallOffScreenY"| gameDisplayControl
    spawnables -->|"init(pDepot,pBallSpawner,indexSlot),<br>spawnAt(x,y),<br>update,<br>isHitAtPos(x,y,ballRadius),<br>getPosX,<br>getPosY,<br>wasHit,<br>getCrateState"| crateControl
    spawnables -->|"init(gameDisplayControl,pBallCollisionCheck,pDepot,indexSlot),<br>setBallListener(pBallListener),<br>spawnInTheMiddle,<br>spawnAt(x,y),<br>update,<br>getBallState"| ballControl
    spawnables -->|"init(pDepot,indexSlot),<br>spawnAt(x,y),<br>update,<br>isTouchedAtPos(x,y,ballRadius),<br>getFireBinState"| fireBinControl
    spawnables -->|"updateGameObjects(ballStates,crateStates,fireBinStates,score)"| gameDisplayControl
    gameControl -->|"spawnBallInTheMiddle,<br>spawnCrateAt(x,y),<br>spawnFireBinAt(x,y),<br>releaseCratesAndFireBins,<br>setPaddlePosition(x),<br>updateBalls,<br>updateCratesAndFireBins,<br>publishStates(score),<br>setBallListener(pBallListener),<br>getNofBallsInUse,<br>getNofCratesInUse,<br>getNofFireBinsInUse"| spawnables
    gameControl -->|"enable,<br>disable,<br>getPaddlePosition"| paddleControl
    gameControl -->|"showGamePage,<br>hideGamePage,<br>showGameOverLabel,<br>hideGameOverLabel,<br>getWidth,<br>getHeight"| gameDisplayControl
    buttonGameOverLabel -->|"buttonPressed(pButton)"| gameControl
    adcButtons -->|"buttonPressed(buttonIndex),<br>buttonReleased(buttonIndex)"| paddleControl
    paddleControl -->|"getWidth,<br>updatePaddlePosition(x),<br>showPaddle,<br>hidePaddle"| gameDisplayControl
    buttonLeft -->|"buttonPressed(pButton),<br>buttonReleased(pButton)"| paddleControl
    buttonRight -->|"buttonPressed(pButton),<br>buttonReleased(pButton)"| paddleControl

    %% Notes
    note_1["Note: normally, it's okay to postpone adding<br>handler patterns to the class diagram phase. this<br>time, however, I decided to update the object<br>model with it too, because of the insertion of a<br>#quot;Spawnables#quot; object to faciliate mass data<br>transfer between tasks (which is not possible with<br>a simple Handler pattern alone)."]:::note
    note_2["Note: as far as this object model is concerned,<br>the DisplayControl objects may be viewed as<br>boundary objects."]:::note
    note_3["Note: normally, it's okay to postpone «isActive»<br>stereotyping to the class diagram, after Task<br>structuring. I chose to update the object model<br>with the results of that task structuring, also<br>resulting in some #quot;do#quot; functions, rather than<br>asynchronous #quot;start#quot; and #quot;finish#quot; handshakes."]:::note
    note_4["Note: calls starting with #quot;do#quot; imply union of<br>tasks, in this case based on control cohesion"]:::note

